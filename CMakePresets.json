{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "wums-base",
      "hidden": true,
      "generator": "Ninja",
      "environment": {
        "baseBinaryDir": "${sourceDir}/build/wums"
      },
      "toolchainFile": "${sourceDir}/cmake/wums-toolchain.cmake"
    },
    {
      "name": "wums-rel",
      "displayName": "WUMS Release",
      "inherits": ["wums-base"],
      "binaryDir": "$env{baseBinaryDir}/rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wums-dbg",
      "displayName": "WUMS Debug",
      "inherits": ["wums-base"],
      "binaryDir": "$env{baseBinaryDir}/dbg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "wums-rel-dbg-info",
      "displayName": "WUMS Release with Debug Info",
      "inherits": ["wums-base"],
      "binaryDir": "$env{baseBinaryDir}/rel-dbg-info",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "wums-rel-min-size",
      "displayName": "WUMS Minimum Size Release",
      "inherits": ["wums-base"],
      "binaryDir": "$env{baseBinaryDir}/rel-min-size",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel"
      }
    }
  ]
}